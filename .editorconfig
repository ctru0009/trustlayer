root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,csproj,props,targets}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.cs]
indent_size = 4
max_line_length = 120
# CA1502 (cyclomatic complexity) stays enabled however AnalysisMode is set;
# the threshold itself lives in dotnet/CodeMetricsConfig.txt (flags >= 40).
dotnet_diagnostic.CA1502.severity = error

[*.{sln,slnx}]
indent_size = 3
