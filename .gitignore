# --- Data: never commit raw or derived data (spec section 5) -----------------
# data/* is used instead of data/ so that this file and data/scripts/ can be
# re-included: git cannot un-ignore a file whose parent directory is excluded.
data/*
!data/SOURCES.md
!data/scripts/
# Split manifests are committable: doc_ids are content hashes (`split:sha8`),
# no email text. Gold labels stay ignored (they embed chunk text). The parent
# chain must be un-ignored first: git cannot re-include under an excluded dir.
!data/gold/
data/gold/*
!data/gold/splits/
data/gold/splits/*
!data/gold/splits/*.txt

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# --- .NET --------------------------------------------------------------------
[Bb]in/
[Oo]bj/
TestResults/
.vs/

# --- Notebook outputs --------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- OS and editor -----------------------------------------------------------
.DS_Store
.idea/
*.swp
