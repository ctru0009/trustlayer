# Copy to .env (git-ignored) and adjust. Placeholders only, never real secrets.
# docker-compose.yml reads this file automatically and falls back to the same
# defaults, so `make up` works on a fresh clone before this file exists.

POSTGRES_USER=trustlayer
POSTGRES_PASSWORD=trustlayer_local
POSTGRES_DB=trustlayer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Phase 8: gateway → model-service URL (compose overrides per service).
MODEL_SERVICE_URL=http://localhost:8000
# Phase 8: demo JWT secret — dev default only, never a real secret.
JWT_SECRET=dev-only-change-me
